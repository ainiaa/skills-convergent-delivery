## Keep the repository-provided Claude Code skill entry point versioned.
!.claude/
!.claude/skills/
!.claude/skills/converge

# Runtime state belongs under ~/.convergent-delivery, never in the repository.
# No ignore rules for it on purpose: any state appearing here must show up as untracked.

__pycache__/
*.py[cod]

# Local verification output.
.venv/
.coverage
.coverage.*
htmlcov/
coverage.xml
.pytest_cache/
mutants/
