{
  "schema_version": 2,
  "provider": {
    "id": "pdlc-v1",
    "source_id": "kanfu-panda/pdlc-skills",
    "version": "compatible-pdlc-v1",
    "role": "workflow"
  },
  "capabilities": {
    "task_kinds": ["feature", "fix", "refactor"],
    "stages": ["plan", "tdd", "implement", "review"]
  },
  "task_contracts": {
    "feature": {
      "entrypoint": "pdlc-feature/SKILL.md",
      "closure": ["pdlc-tdd/SKILL.md", "pdlc-implement/SKILL.md", "pdlc-review/SKILL.md"],
      "required_terms": ["name: pdlc-feature", "name: pdlc-tdd", "name: pdlc-implement", "name: pdlc-review", "TDD", "测试", "评审"],
      "preserve_external_behavior": false
    },
    "fix": {
      "entrypoint": "pdlc-fix/SKILL.md",
      "closure": ["pdlc-tdd/SKILL.md", "pdlc-implement/SKILL.md", "pdlc-review/SKILL.md"],
      "required_terms": ["name: pdlc-fix", "name: pdlc-tdd", "name: pdlc-implement", "name: pdlc-review", "复现", "修复", "测试", "评审"],
      "preserve_external_behavior": false
    },
    "refactor": {
      "entrypoint": "pdlc-refactor/SKILL.md",
      "closure": ["pdlc-tdd/SKILL.md", "pdlc-implement/SKILL.md", "pdlc-review/SKILL.md"],
      "required_terms": ["name: pdlc-refactor", "name: pdlc-tdd", "name: pdlc-implement", "name: pdlc-review", "重构", "行为不变", "测试", "评审"],
      "preserve_external_behavior": true
    }
  },
  "authorization": {
    "stop_for": ["business_rules", "public_contracts", "permissions", "release", "irreversible_actions"],
    "forbidden_actions": ["pdlc-ship", "commit", "tag", "push", "publish", "install"]
  },
  "outputs": {
    "progress_protocol": 1,
    "required_evidence": ["tests", "validation", "findings"]
  }
}
